# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# Gemini API key（LLM_PROVIDER=aistudio 时必填；从 https://aistudio.google.com/apikey 获取）
GEMINI_API_KEY=

# 使用的 Gemini 模型。可写逗号分隔的优先级列表：前一个 404 / 429 / 503 时自动降级到下一个
# （注意：gemini-2.5-flash 对新账号已下线）
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# LLM 提供方：aistudio（用 API key）或 vertex（用 GCP 项目 + ADC 凭据）
LLM_PROVIDER=aistudio

# LLM_PROVIDER=vertex 时必填：GCP 项目 ID
GCP_PROJECT=

# LLM_PROVIDER=vertex 时可选：区域，默认 us-central1
GCP_LOCATION=us-central1

# 可选：两次 LLM 调用的最小间隔（秒）。AI Studio 免费额度按每分钟请求数限流时用；
# gemini-2.5-flash 约 6.5，gemini-2.5-flash-lite 约 4.5，付费 / Vertex 填 0
LLM_MIN_INTERVAL=0

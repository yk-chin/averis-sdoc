# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# Gemini API key（LLM_PROVIDER=aistudio 时必填；从 https://aistudio.google.com/apikey 获取）
GEMINI_API_KEY=

# 使用的 Gemini 模型
GEMINI_MODEL=gemini-2.5-flash

# LLM 提供方：aistudio（用 API key）或 vertex（用 GCP 项目 + ADC 凭据）
LLM_PROVIDER=aistudio

# LLM_PROVIDER=vertex 时必填：GCP 项目 ID
GCP_PROJECT=

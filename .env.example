# Copy to .env and fill in. .env is in .gitignore and is never committed.

# Gemini API key (required when LLM_PROVIDER=aistudio; get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gemini model(s). A comma-separated priority list: on 404 / 429 / 503 the next one is used
# (note: gemini-2.5-flash is retired for new accounts)
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# LLM provider: aistudio (API key) or vertex (GCP project + ADC credentials)
LLM_PROVIDER=aistudio

# Required when LLM_PROVIDER=vertex: the GCP project ID
GCP_PROJECT=

# Optional when LLM_PROVIDER=vertex: region, default us-central1
GCP_LOCATION=us-central1

# Optional: minimum seconds between two LLM calls, for the AI Studio free tier's per-minute limit;
# gemini-2.5-flash ~6.5, gemini-2.5-flash-lite ~4.5, paid / Vertex 0
LLM_MIN_INTERVAL=0
